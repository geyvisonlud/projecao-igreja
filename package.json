{
  "name": "projecao-igreja",
  "version": "0.3.0",
  "description": "Software de apresentação para igreja: letras de músicas, timer e fundos em vídeo",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.igreja.projecao",
    "productName": "Projeção Igreja",
    "files": ["main.js", "preload.js", "src/**/*", "assets/**/*"],
    "asarUnpack": ["assets/**/*"],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    }
  }
}
